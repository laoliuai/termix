# Path to the repository root, relative to docker-compose.yml.
# Override only if you copy dev/devbox/ to a different relative depth.
WORKSPACE_DIR=../..

# HOST_UID and HOST_GID are consumed at BUILD time so the container's `dev`
# user matches your host UID/GID (otherwise bind-mounted files end up owned by
# the wrong user). Do NOT set them here — export them in your shell instead so
# a stale value in this file cannot silently mismatch your real UID:
#
#   export HOST_UID=$(id -u) HOST_GID=$(id -g)
#   docker compose build
#
# If neither the shell env nor a build-arg supplies them, the Dockerfile falls
# back to 1000/1000 (the typical first-user default on Linux).

# HTTP/SOCKS proxy on the host (e.g. Clash, mihomo). Inside the container,
# 127.0.0.1 points at the container itself, so we route through the host
# via host.docker.internal (mapped via extra_hosts in docker-compose.yml).
# Comment these out if you do not run a host-side proxy.
HTTP_PROXY=http://host.docker.internal:7897
HTTPS_PROXY=http://host.docker.internal:7897
ALL_PROXY=socks5://host.docker.internal:7897
http_proxy=http://host.docker.internal:7897
https_proxy=http://host.docker.internal:7897
all_proxy=socks5://host.docker.internal:7897
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Drop any extra environment variables you want forwarded into the container
# below (the `env_file: .env` directive in docker-compose.yml passes them
# through). The AI coding CLIs (claude / codex / opencode) handle their own
# auth — usually via interactive login that persists into the per-agent named
# volumes — so no API keys are required here by default.
