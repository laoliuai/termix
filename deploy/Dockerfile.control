FROM node:22-alpine AS web-builder
WORKDIR /app/web/app
COPY web/app/package*.json ./
RUN npm ci --silent
COPY web/app/ ./
RUN npm run build

FROM golang:1.25-alpine AS go-builder
WORKDIR /app
COPY go/go.mod go/go.sum ./go/
RUN cd go && go mod download
COPY go/ ./go/
COPY --from=web-builder /app/web/app/dist/ ./go/internal/controlapi/web_dist/
RUN cd go && go build -o bin/termix-control ./cmd/termix-control

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
COPY --from=go-builder /app/go/bin/termix-control /usr/local/bin/termix-control
EXPOSE 8080 9090
ENTRYPOINT ["termix-control"]
